    <!-- 
      This is the main section for the single course.
      All class names are prefixed with 'single-course-'
    -->
    <section class="single-course-section">
        <div class="single-course-container">
            
            <!-- Column 1: Course Image -->
            <div class="single-course-image-wrapper">
                <img src="assets/st1.JPG" alt="Advanced Data Science Course">
            </div>

            <!-- Column 2: Course Details -->
            <div class="single-course-details-wrapper">
                <h2 class="single-course-title">Advanced Data Science with Python</h2>
                
                <div class="single-course-meta">
                    <span class="single-course-meta-item" id="single-course-duration">
                        <strong>Duration:</strong> 12 Weeks
                    </span>
                    <span class="single-course-meta-item" id="single-course-format">
                        <strong>Format:</strong> Online, Self-Paced
                    </span>
                    <span class="single-course-meta-item" id="single-course-level">
                        <strong>Level:</strong> Advanced
                    </span>
                </div>

                <div class="single-course-description">
                    <p>
                        Master the essential skills of data science. This course covers everything from data manipulation and visualization with Pandas and Matplotlib to advanced machine learning models...
                        <!-- This span holds the dots (...) -->
                        <span id="single-course-dots">...</span>
                        <!-- This span holds the hidden text -->
                        <span id="single-course-more-text">
                            You will dive deep into statistical analysis, feature engineering, and real-world project deployment. Our curriculum is designed by industry experts to ensure you learn the most relevant, in-demand skills. You'll complete three major capstone projects to build a robust portfolio.
                        </span>
                    </p>
                    <!-- This button triggers the JavaScript -->
                    <button id="single-course-toggle-btn">Read More</button>
                </div>

                <div class="single-course-footer">
                    <span class="single-course-price">$499.00</span>
                    <a href="#enroll" class="single-course-enroll-btn">Enroll Now</a>
                </div>
            </div>

        </div>
    </section>

